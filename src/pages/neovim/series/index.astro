---
import Layout from '@layouts/Neovim.astro';
import { getCollection } from 'astro:content';

const allSeries = await getCollection('series');
---

<Layout title="My Series">
  <div class="neovim-blog-post max-w-4xl pb-20">
    <h1 class="text-2xl font-bold mb-8 text-green nvim-line">:series</h1>

    <div class="space-y-8">
      {allSeries.map((series) => (
        <a href={`/neovim/series/${series.id}`} data-href={`/neovim/series/${series.id}`} class="block p-4 border border-gray-800 rounded-lg hover:bg-gray-900 transition-colors nvim-line">
          <h2 class="text-xl font-semibold text-blue">{series.data.title}</h2>
          <p class="mt-2 text-gray-400">{series.data.description}</p>
          <p class="mt-3 text-xs text-green">{series.data.items.length} {series.data.items.length === 1 ? 'item' : 'items'}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
