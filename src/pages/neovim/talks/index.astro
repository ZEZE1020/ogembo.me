---
import Layout from '@layouts/Neovim.astro';
import { getCollection } from 'astro:content';

const allTalks = await getCollection('talks');
const sortedTalks = allTalks.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="My Talks">
  <div class="neovim-blog-post max-w-4xl pb-20">
    <h1 class="text-2xl font-bold mb-8 text-green nvim-line">:talks</h1>

    <div class="space-y-8">
      {sortedTalks.map((talk) => (
        <a href={`/neovim/talks/${talk.id}`} class="block p-4 border border-gray-800 rounded-lg hover:bg-gray-900 transition-colors nvim-line">
          <h2 class="text-xl font-semibold text-blue">{talk.data.title}</h2>
          <p class="text-gray-400 text-sm mt-1">
            {talk.data.date.toLocaleDateString()}
            {talk.data.event && ` — ${talk.data.event}`}
          </p>
        </a>
      ))}
    </div>
  </div>
</Layout>